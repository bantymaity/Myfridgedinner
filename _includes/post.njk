<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ title }} | MyFridgeDinner</title>
  <meta name="description" content="{{ description }}">
  <meta name="keywords" content="{{ keywords }}">
  <meta name="theme-color" content="#090d16">
  
  <link rel="stylesheet" href="/style.css"> 
</head>
<body>

  <!-- মেনুবার -->
  <header class="site-header">
    <div class="hdr-inner">
      <a class="logo" href="/index.html"><span class="logo-icon">🥘</span><span class="logo-txt">MyFridge<span>Dinner</span></span></a>
      <nav class="main-nav">
        <a href="/index.html" class="nav-a">🏠 Generator</a>
        <a href="/blog.html" class="nav-a on">📰 Blog</a>
      </nav>
    </div>
  </header>

  <!-- ব্লগের মূল কন্টেইনার -->
  <main id="main-content">
    <article class="feat-art">
      <div class="feat-tag">⭐ Featured Story</div>
      
      <!-- এসইও ফ্রেন্ডলি অটোমেটিক টাইটেল -->
      <h1>{{ title }}</h1>
      
      <div class="post-meta">
        <span>📅 {{ date }}</span>
        <span>✍️ MyFridgeDinner Team</span>
      </div>

      <div class="post-img-wrap">
        <img src="{{ image }}" alt="{{ title }}">
      </div>

      <!-- 🎯 আপনার লেখাগুলো এই 'art-body' ক্লাসের ভেতরে অটোমেটিক বসে ওয়েবসাইটের ডিজাইন পেয়ে যাবে -->
      <div class="art-body">
        {{ content | safe }}
      </div>

    </article>
  </main>

</body>
</html>
